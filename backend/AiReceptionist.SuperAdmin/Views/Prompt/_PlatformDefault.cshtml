@model string
@*
    The wording a rewritten section replaced, folded away until asked for. Shown next to the box it
    was edited out of, so an operator can put it back without hunting through the source.
*@
<details style="margin-top:8px;">
    <summary class="help" style="cursor:pointer;">Show the platform default for this section</summary>
    <pre class="mono" style="white-space:pre-wrap;font-size:12px;line-height:1.5;max-height:260px;overflow:auto;">@Model</pre>
</details>
