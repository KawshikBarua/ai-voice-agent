@model PromptTemplateStatus
@{
    ViewData["Title"] = "AI Prompt";
    var organizations = ViewBag.Organizations as IReadOnlyList<OrganizationRow> ?? [];
    var preview = ViewBag.Preview as PromptPreview;
    var connected = organizations.Count(o => o.IsAgentConnected);
}

@functions {
    // The default text for a section that has been rewritten, else null. Undoing a bad edit means
    // knowing what the text used to be, and by then the box no longer contains it.
    static string? ReplacedDefault(string current, string? platformDefault) =>
        string.IsNullOrWhiteSpace(platformDefault) || current.Trim() == platformDefault.Trim()
            ? null
            : platformDefault;
}

<div class="page-head">
    <div>
        <h1>AI prompt</h1>
        <p>
            The words every tenant's receptionist is built from — how it talks and what it must never
            do on every turn, then what it does at each stage of a call. One text for the whole platform.
            Saving stores it; a live agent only picks it up the next time that organization is
            synced from the Retell AI screen.
        </p>
    </div>
</div>

@if (Model is null)
{
    <div class="banner problem">
        Could not reach the tenant API, so the prompt cannot be read or changed.
        Start <span class="mono">AiReceptionist.Api</span> and reload this page.
    </div>
}
else
{
    <div class="grid two">
        <div class="card">
            <h2>Status</h2>
            <p class="sub">What is in force right now.</p>
            <div class="kv">
                <span>Wording</span>
                <span>
                    @if (Model.IsCustomised)
                    {
                        <span class="chip accent">Customised</span>
                    }
                    else
                    {
                        <span class="chip ok">Platform default</span>
                    }
                </span>
            </div>
            <div class="kv"><span>Last changed</span><span>@Display.When(Model.ModifiedAt)</span></div>
            <div class="kv"><span>Connected agents</span><span>@connected</span></div>
            @if (Model.IsCustomised)
            {
                <div class="kv">
                    <span>Changed sections</span>
                    <span style="font-weight:400;text-align:left;">@string.Join(", ", Model.CustomisedSections)</span>
                </div>
            }
            <p class="note">
                Clearing a box restores that section to the platform default — and keeps it tracking
                the default as the product's own wording improves. Only sections you actually change
                are stored.
            </p>
            <p class="note">
                Nothing here is pushed to Retell. Agents keep the prompt they were built with until
                they are re-synced, so you can edit, preview and come back to it — then roll it out
                one organization at a time from <a asp-controller="Retell" asp-action="Index">Retell AI</a>.
            </p>
            <form method="post" asp-action="Reset" style="margin-top:12px;"
                  onsubmit="return confirm('Restore every section to the platform default?');">
                @Html.AntiForgeryToken()
                <button class="btn small danger" type="submit" disabled="@(!Model.IsCustomised)">
                    Restore all defaults
                </button>
            </form>
        </div>

        <div class="card">
            <h2>Preview a tenant</h2>
            <p class="sub">The finished prompt, with that tenant's facts filled in.</p>
            <form method="get" asp-action="Index">
                <div class="field">
                    <label for="preview">Organization</label>
                    <select id="preview" name="preview">
                        @foreach (var org in organizations)
                        {
                            <option value="@org.Id" selected="@(preview?.OrganizationId == org.Id)">
                                @org.Name — @org.Industry
                            </option>
                        }
                    </select>
                    <div class="help">
                        Industry decides how a tenant finds a time: on-site trades get the version for
                        trades that travel to the customer, everyone else the standard one.
                    </div>
                </div>
                <button class="btn" type="submit" disabled="@(organizations.Count == 0)">Show prompt</button>
            </form>

            @if (preview is not null)
            {
                <h2 style="margin-top:20px;">@preview.OrganizationName</h2>
                <pre class="mono" style="white-space:pre-wrap;font-size:12px;line-height:1.5;max-height:420px;overflow:auto;">@preview.Prompt</pre>
            }
        </div>
    </div>

    <form method="post" asp-action="Save">
        @Html.AntiForgeryToken()

        <div class="card">
            <h2>How the agent talks</h2>
            <p class="sub">Voice and manner. This is what stops it sounding like a machine.</p>
            <div class="field">
                <textarea name="Persona" rows="18">@Model.Persona</textarea>
                <div class="help">Everything here is spoken aloud — write for the ear, not the page.</div>
                @if (ReplacedDefault(Model.Persona, Model.Defaults.Persona) is { } personaDefault)
                {
                    <partial name="_PlatformDefault" model="personaDefault" />
                }
            </div>
        </div>

        <div class="card">
            <h2>Rules it never breaks</h2>
            <p class="sub">Safety and honesty. Nothing else in the prompt may override these.</p>
            <div class="field">
                <textarea name="CoreRules" rows="12">@Model.CoreRules</textarea>
                @if (ReplacedDefault(Model.CoreRules, Model.Defaults.CoreRules) is { } coreRulesDefault)
                {
                    <partial name="_PlatformDefault" model="coreRulesDefault" />
                }
            </div>
        </div>

        @* One card per call state. Only one state's text is in front of the agent at a time, appended
           to the two sections above, together with only the tools that stage of the call uses. *@
        @foreach (var (name, title, sub, current, platformDefault) in new[]
        {
            ("TriageState", "Finding out what they need", "Where every call starts: what they want, urgency first, questions answered on the spot.", Model.TriageState, Model.Defaults.TriageState),
            ("SchedulingState", "Finding a time — businesses the customer comes to", "Clinics, salons, workshops, offices. Tools: availability, plus the address check where a coverage area is drawn.", Model.SchedulingState, Model.Defaults.SchedulingState),
            ("FieldSchedulingState", "Finding a time — trades that travel to the customer", "Plumbing, electrical, HVAC, locksmiths, cleaning. Tools: availability, customer lookup, plus the address check where a coverage area is drawn.", Model.FieldSchedulingState, Model.Defaults.FieldSchedulingState),
            ("BookingState", "Taking the booking", "A time is agreed. Tools: customer lookup, booking.", Model.BookingState, Model.Defaults.BookingState),
            ("ExistingBookingState", "An appointment they already have", "Checking, moving or cancelling. Tools: appointment lookup, reschedule, cancel, availability.", Model.ExistingBookingState, Model.Defaults.ExistingBookingState),
        })
        {
            <div class="card">
                <h2>@title</h2>
                <p class="sub">@sub</p>
                <div class="field">
                    <textarea name="@name" rows="10">@current</textarea>
                    @if (ReplacedDefault(current, platformDefault) is { } stateDefault)
                    {
                        <partial name="_PlatformDefault" model="stateDefault" />
                    }
                </div>
            </div>
        }

        <button class="btn" type="submit">Save prompt</button>
    </form>
}
