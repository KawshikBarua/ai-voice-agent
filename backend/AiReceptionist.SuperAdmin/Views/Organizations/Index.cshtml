@model OrganizationListViewModel
@{
    ViewData["Title"] = "Organizations";
    var filters = new (string Key, string Label)[]
    {
        ("all", "All"),
        ("active", "Active"),
        ("suspended", "Disabled"),
        ("overdue", "Overdue"),
        ("unbilled", "No subscription"),
        ("connected", "Agent connected"),
        ("disconnected", "Not connected"),
    };
}

<div class="page-head">
    <div>
        <h1>Organizations</h1>
        <p>Every tenant on the platform. Open one to manage its Retell agent, subscription and account status.</p>
    </div>
    @* Creating the organization and its first login is one act, so the entry point is the account
       form — there is no way to add an organization nobody can sign in to. *@
    <a class="btn" asp-controller="Users" asp-action="Create">New organization &amp; login</a>
</div>

<form class="filters" method="get" asp-action="Index">
    <input type="text" name="search" value="@Model.Search" placeholder="Search name, email, industry…" />
    <input type="hidden" name="filter" value="@Model.Filter" />
    <button class="btn small" type="submit">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a class="btn small outline" asp-action="Index" asp-route-filter="@Model.Filter">Clear</a>
    }
</form>

<div class="filters tabs">
    @foreach (var (key, label) in filters)
    {
        <a class="@(Model.Filter == key ? "active" : "")"
           asp-action="Index" asp-route-filter="@key" asp-route-search="@Model.Search">@label</a>
    }
</div>

<div class="card">
    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                <th>Organization</th>
                <th>Contact</th>
                <th>Account</th>
                <th>Billing</th>
                <th>AI agent</th>
                <th class="num">Revenue</th>
                <th class="num">Calls</th>
                <th class="num">Users</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Organizations.Count == 0)
            {
                <tr><td colspan="9" class="empty">No organizations match this view.</td></tr>
            }
            @foreach (var org in Model.Organizations)
            {
                <tr>
                    <td class="org-name">@org.Name<small>@org.Industry</small></td>
                    <td>
                        @(org.Email ?? "—")
                        <small style="display:block;color:var(--muted);font-size:11.5px;">@(org.Phone ?? "")</small>
                    </td>
                    <td>
                        @if (org.IsActive)
                        {
                            <span class="chip ok">Active</span>
                        }
                        else
                        {
                            <span class="chip danger" title="@org.SuspendedReason">Disabled</span>
                        }
                    </td>
                    <td>
                        <span class="@Display.BillingChip(org)">@Display.BillingLabel(org)</span>
                        <small style="display:block;color:var(--muted);font-size:11.5px;">@Display.BillingDetail(org)</small>
                    </td>
                    <td>
                        @if (org.IsAgentConnected)
                        {
                            <span class="chip accent">Connected</span>
                        }
                        else
                        {
                            <span class="chip">Not connected</span>
                        }
                    </td>
                    <td class="num">@org.Revenue.ToString("N0") @org.Currency</td>
                    <td class="num">@org.TotalCalls</td>
                    <td class="num">@org.UserCount</td>
                    <td class="num">
                        <a class="btn small outline" asp-action="Details" asp-route-id="@org.Id">Open</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
